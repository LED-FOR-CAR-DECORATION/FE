{"openapi":"3.1.0","info":{"title":"Lumintra Backend API","description":"REST API documentation for Lumintra LED Car Decoration Platform","contact":{"name":"Lumintra Engineering Team","email":"noreply@lumintra.shop"},"version":"1.0.0"},"servers":[{"url":"http://localhost:8080","description":"Generated server url"}],"tags":[{"name":"Authentication","description":"Endpoints for user authentication and account registration"}],"paths":{"/api/auth/verify-email":{"post":{"tags":["Authentication"],"summary":"Verify customer email with OTP","description":"Validates the 6-digit OTP code sent to customer's email during registration. Upon successful validation, transitions customer account status from PENDING_VERIFICATION to ACTIVE.","operationId":"verifyEmail","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/VerifyEmailRequest"}}},"required":true},"responses":{"200":{"description":"Email verified successfully; account is now ACTIVE","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiResponse"},"examples":{"Success":{"description":"Success","value":{"data":"Email verified successfully"}}}}}},"400":{"description":"Validation failed: request payload contains invalid fields, invalid/expired OTP, or account already verified","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"},"examples":{"Validation Error":{"description":"Validation Error","value":{"code":"VALIDATION_FAILED","message":"Invalid request payload","status":400,"timestamp":"2026-11-04T12:00:00Z","traceId":"trace-12345","details":[{"field":"otp","message":"OTP must be exactly 6 digits"}]}},"Invalid OTP":{"description":"Invalid OTP","value":{"code":"INVALID_OTP","message":"Invalid or expired OTP.","status":400,"timestamp":"2026-11-04T12:00:00Z","traceId":"trace-12345","details":[]}},"Account Already Verified":{"description":"Account Already Verified","value":{"code":"ACCOUNT_ALREADY_VERIFIED","message":"Account is already verified